# Copy this file to .env and fill in your values. .env is gitignored, never commit it.

# Groq API key for lease extraction (https://console.groq.com/keys)
GROQ_API_KEY=

# Groq model used for extraction. Check https://console.groq.com/docs/models for current names.
GROQ_MODEL=openai/gpt-oss-120b

# Longer leases are split into parts of about this many tokens (free tier: keep at 4000 or below)
GROQ_MAX_INPUT_TOKENS=4000

# Where the local DuckDB database lives
LANDRISK_DB=data/landrisk.duckdb

# Fields below this confidence go to the human review queue
REVIEW_CONFIDENCE_THRESHOLD=0.85

# Regex matched against RRC operator names to find bpx's operator numbers
RRC_OPERATOR_PATTERN=^BPX

# Frontend -> API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# SEC EDGAR requires a name and contact email on every request (ingest-edgar)
SEC_USER_AGENT=
